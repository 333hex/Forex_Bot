# Twelve Data market data (https://twelvedata.com/)
# Twelve Data API key.
MARKET_DATA_PROVIDER=twelve_data
TWELVE_DATA_API_KEY=
# Basic plan pacing; raise/lower only to match your account allowance.
TWELVE_DATA_MIN_REQUEST_INTERVAL_SECONDS=7.5

# Seven supported majors are enabled by default. Keep slash or underscore format.
FOREX_SYMBOLS=EUR_USD,GBP_USD,USD_JPY,USD_CHF,AUD_USD,NZD_USD,USD_CAD
SCAN_INTERVAL_SECONDS=3600
TRADING_MODE=signal

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Existing strategy/risk settings
RISK_PER_TRADE_PERCENT=0.5
MAX_DAILY_LOSS_PERCENT=2
MAX_OPEN_PAPER_TRADES=3
MAX_TRADES_PER_DAY=5
MIN_REWARD_RISK=1.5
MAX_SPREAD_PIPS=2.5
